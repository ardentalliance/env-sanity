{
  "DATABASE_URL": {
    "required": true
  },
  "SESSION_SECRET": {
    "required": true,
    "minLength": 32,
    "allowPlaceholder": true
  },
  "NODE_ENV": {
    "required": false,
    "allowedValues": ["development", "test", "production"]
  },
  "SMTP_PORT": {
    "required": false,
    "type": "number"
  },
  "FEATURE_FLAG_EMAIL": {
    "required": false,
    "type": "boolean"
  }
}